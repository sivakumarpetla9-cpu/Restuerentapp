# AI Business Agent - Local Environment Configuration
AI_PROVIDER=ollama
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:8b

# Database Persistence Configuration (Neon PostgreSQL / Local JSON)
# Active Provider: "postgres" (Production Neon PostgreSQL) or "json" (Local Fallback)
DATABASE_PROVIDER=postgres
DATABASE_URL=

# Initial Admin Bootstrap (Used only for local first-time setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session Security Secret
SESSION_SECRET=

# Communication Gateway Configuration
# Active Provider: "local" (₹0 Simulator) or "brevo" (Real Transactional Email)
COMMUNICATION_PROVIDER=local
EMAIL_PROVIDER=brevo

# Brevo Transactional Email Configuration (₹0 Free Plan: 300 emails/day)
# Obtain free API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_WEBHOOK_SECRET=

# Future Provider Stubs (Optional)
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
